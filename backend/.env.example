# ── LLM Provider (Person 4) ──────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Upload Limits ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Retrieval Tuning ─────────────────────────────────────────────────────
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=80
TOP_K_EVIDENCE=3
